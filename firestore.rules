
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if a user owns a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Logged in users can create their own orders
    match /orders/{orderId} {
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
    }

    // Restaurants and their menus should be publicly readable
    match /restaurants/{restaurantId} {
      allow read: if true;
      // Write access should be restricted to admins (future implementation)
      allow write: if false;

      match /menu_items/{menuItemId} {
        allow read: if true;
        // Write access should be restricted to admins (future implementation)
        allow write: if false;
      }

      match /reviews/{reviewId} {
         // Anyone can read reviews
        allow read: if true;
        // Only authenticated users can create reviews for themselves
        allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      }
    }

    // Dietary restrictions should be publicly readable
    match /dietary_restrictions/{dietaryRestrictionId} {
      allow read: if true;
       // Write access should be restricted to admins (future implementation)
      allow write: if false;
    }
  }
}
