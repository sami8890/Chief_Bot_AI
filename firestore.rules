/**
 * @fileoverview Firestore Security Rules for GastronomicAI application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict data ownership model for user-specific data (preferences).
 * Restaurant and MenuItem data is publicly readable, but write access is generally denied
 * except where explicitly allowed.  Reviews are publicly readable and writable.
 *
 * Data Structure:
 * - /restaurants/{restaurantId}: Stores public restaurant data.
 * - /restaurants/{restaurantId}/menu_items/{menuItemId}: Stores public menu item data for each restaurant.
 * - /dietary_restrictions/{dietaryRestrictionId}: Stores global dietary restrictions.
 * - /menu_item_dietary_restrictions/{menuItemDietaryRestrictionId}: Stores the relationships between menu items and dietary restrictions.
 * - /users/{userId}/preferences/{userPreferenceId}: Stores private user preferences.
 * - /restaurants/{restaurantId}/reviews/{reviewId}: Stores public reviews for each restaurant.
 *
 * Key Security Decisions:
 * - Restaurants and menu items are generally publicly readable.
 * - User preferences are private and only accessible to the owning user.
 * - Reviews are publicly readable and writable, so abusive reviews must be handled via other means (e.g. moderation).
 * - Listing all documents in a collection should be avoided unless the data is intended to be fully public.
 * - The rules do not enforce a strict schema, allowing for flexible data shapes during prototyping.
 *
 * Denormalization for Authorization:
 * - The application avoids `get()` calls by denormalizing authorization data. For example,
 *   if access to a MenuItem needs to be restricted to certain restaurant staff, the staff's
 *   UIDs would be stored in a `members` map within the Restaurant document, and this `members`
 *   map would be copied into each MenuItem document under that restaurant. This allows security
 *   rules for MenuItems to be evaluated without needing to read the parent Restaurant document.
 *
 * Structural Segregation:
 * - User preferences are stored under `/users/{userId}/preferences` to ensure private user data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read-only access to restaurants. Write access is denied.
     * @path /restaurants/{restaurantId}
     * @allow get, list: if true;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read access to restaurant information.
     */
    match /restaurants/{restaurantId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows read-only access to menu items. Write access is denied.
     * @path /restaurants/{restaurantId}/menu_items/{menuItemId}
     * @allow get, list: if true;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read access to menu item information.
     */
    match /restaurants/{restaurantId}/menu_items/{menuItemId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows read-only access to dietary restrictions. Write access is denied.
     * @path /dietary_restrictions/{dietaryRestrictionId}
     * @allow get, list: if true;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read access to dietary restriction information.
     */
    match /dietary_restrictions/{dietaryRestrictionId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows read-only access to menu item dietary restrictions. Write access is denied.
     * @path /menu_item_dietary_restrictions/{menuItemDietaryRestrictionId}
     * @allow get, list: if true;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read access to menu item dietary restriction information.
     */
    match /menu_item_dietary_restrictions/{menuItemDietaryRestrictionId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages user preferences. Allows a user to read and write their own preferences only.
     * @path /users/{userId}/preferences/{userPreferenceId}
     * @allow get, list: if isOwner(userId);
     * @allow create: if isOwner(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @allow (create): if request.auth.uid == userId;
     * @allow (update): if request.auth.uid == userId && resource != null;
     * @allow (delete): if request.auth.uid == userId && resource != null;
     * @deny get, list: if !isSignedIn();
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Enforces user-ownership for preferences; requires authentication.
     */
    match /users/{userId}/preferences/{userPreferenceId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows read and write access to restaurant reviews.
     * @path /restaurants/{restaurantId}/reviews/{reviewId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isReviewOwner(request.auth.uid, resource.data.userId) && resource != null;
     * @allow delete: if isReviewOwner(request.auth.uid, resource.data.userId) && resource != null;
     * @principle Public read access to reviews, authenticated write access.
     */
    match /restaurants/{restaurantId}/reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isReviewOwner(request.auth.uid, resource.data.userId) && resource != null;
      allow delete: if isReviewOwner(request.auth.uid, resource.data.userId) && resource != null;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }

    function isReviewOwner(userId, reviewUserId) {
    return userId == reviewUserId;
  }
}