/**
 * @fileoverview Firestore Security Rules for GastronomicAI application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict data ownership model for user-specific data
 * and allows public read access for restaurant and menu item information.
 * It prioritizes security and efficiency by denormalizing authorization
 * data and avoiding complex queries within the rules.
 *
 * Data Structure:
 * - /restaurants/{restaurantId}: Stores restaurant details; publicly readable.
 * - /restaurants/{restaurantId}/menu_items/{menuItemId}: Stores menu items; publicly readable.
 * - /dietary_restrictions/{dietaryRestrictionId}: Stores dietary restrictions; publicly readable.
 * - /menu_item_dietary_restrictions/{menuItemDietaryRestrictionId}: Stores relationships between menu items and dietary restrictions; publicly readable
 * - /users/{userId}/preferences/{userPreferenceId}: Stores user preferences; only accessible by the owner.
 * - /restaurants/{restaurantId}/reviews/{reviewId}: Stores restaurant reviews; publicly readable.
 *
 * Key Security Decisions:
 * - Public read access to restaurants, menu items, dietary restrictions and relationships between menu items and dietary restrictions.
 * - User-owned data is strictly enforced under the /users/{userId} path.
 * - Listing of documents is allowed only when it's safe (e.g., public collections or user-owned subcollections).
 * - Data validation is limited to authorization-critical fields for prototyping flexibility.
 *
 * Denormalization for Authorization:
 *  -  Currently, authorization is based on path and ownership. If more complex
 *     authorization schemes are needed (e.g., restaurant-specific roles),
 *     consider denormalizing role information directly onto the documents.
 *
 * Structural Segregation:
 *  - User preferences are stored in a private subcollection to prevent public listing.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to restaurant details and allows anyone to create, update, or delete restaurants.
     * @path /restaurants/{restaurantId}
     * @allow get, list: if true;
     * @allow create: if true;
     * @allow update: if true;
     * @allow delete: if true;
     * @principle Public read access with open writes.
     */
    match /restaurants/{restaurantId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Grants public read access to menu items and allows anyone to create, update, or delete menu items.
     * @path /restaurants/{restaurantId}/menu_items/{menuItemId}
     * @allow get, list: if true;
     * @allow create: if true;
     * @allow update: if true;
     * @allow delete: if true;
     * @principle Public read access with open writes.
     */
    match /restaurants/{restaurantId}/menu_items/{menuItemId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Grants public read access to dietary restrictions and allows anyone to create, update, or delete dietary restrictions.
     * @path /dietary_restrictions/{dietaryRestrictionId}
     * @allow get, list: if true;
     * @allow create: if true;
     * @allow update: if true;
     * @allow delete: if true;
     * @principle Public read access with open writes.
     */
    match /dietary_restrictions/{dietaryRestrictionId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Grants public read access to menu item dietary restrictions and allows anyone to create, update, or delete menu item dietary restrictions.
     * @path /menu_item_dietary_restrictions/{menuItemDietaryRestrictionId}
     * @allow get, list: if true;
     * @allow create: if true;
     * @allow update: if true;
     * @allow delete: if true;
     * @principle Public read access with open writes.
     */
    match /menu_item_dietary_restrictions/{menuItemDietaryRestrictionId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    /**
     * @description Manages user preferences, allowing only the owner to read, create, update, and delete their own preferences.
     * @path /users/{userId}/preferences/{userPreferenceId}
     * @allow get: if isOwner(userId);
     * @allow list: if isOwner(userId);
     * @allow create: if isOwner(userId);
     * @allow update: if isOwner(userId);
     * @allow delete: if isOwner(userId);
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/preferences/{userPreferenceId} {
      allow get: if isOwner(userId);
      allow list: if false; //Disallow listing
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

   /**
     * @description Grants public read access to restaurant reviews and allows anyone to create, update, or delete restaurant reviews.
     * @path /restaurants/{restaurantId}/reviews/{reviewId}
     * @allow get, list: if true;
     * @allow create: if true;
     * @allow update: if true;
     * @allow delete: if true;
     * @principle Public read access with open writes.
     */
    match /restaurants/{restaurantId}/reviews/{reviewId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }


    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource.data.userId == userId;
    }
  }
}