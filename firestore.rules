
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is the designated admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "admin@gastronomic.ai";
    }

    // Helper function to check if the user is the owner of the data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // USERS:
    // - Authenticated users can read their own profile.
    // - Admin can read any user profile.
    // - Authenticated users can update their own profile.
    // - Admin can update any user profile.
    match /users/{userId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if request.auth != null; // Any authenticated user can create their own profile
    }

    // MENU ITEMS:
    // - Anyone can read the menu.
    // - Only admin can create, update, or delete menu items.
    match /menu_items/{menuItemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ORDERS:
    // - Authenticated users can create orders for themselves.
    // - Users can read their own orders.
    // - Admin can read and update any order (e.g., to change status).
    match /orders/{orderId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, update: if isOwner(resource.data.userId) || isAdmin();
      // No delete for orders to maintain history
    }
  }
}

    