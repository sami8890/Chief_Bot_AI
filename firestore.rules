rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders can be created by authenticated users for themselves.
    // Reading/updating orders should be restricted (e.g., to admins or the user).
    // For now, only allowing create.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if false; // Protect order data
    }

    // Public read access for all restaurant-related data, including menus.
    // Writes should be restricted (e.g., to admins).
    match /restaurants/{path=**} {
      allow read: if true;
      allow write: if false; // Protect restaurant data from public writes
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
